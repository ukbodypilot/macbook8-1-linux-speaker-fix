--- a/sound/hda/codecs/cirrus/cs420x.c
+++ b/sound/hda/codecs/cirrus/cs420x.c
@@ -1,6 +1,7 @@
 /*
  * HD audio interface patch for Cirrus Logic CS420x/CS4208
  *
+ * MacBook8,1 (12" Early 2015) speaker fix
  * Copyright (c) 2009 Takashi Iwai <tiwai@suse.de>
  *
  *  This driver is free software; ...
@@ enum CS4208 fixup IDs
 enum {
 	CS4208_MAC_AUTO,
 	CS4208_MBA6,
 	CS4208_MBP11,
 	CS4208_MACMINI,
+	CS4208_MACBOOK8_1,
 	CS4208_GPIO0,
 };

@@ cs4208_mac_fixup_tbl
 static const struct hda_quirk cs4208_mac_fixup_tbl[] = {
 	SND_PCI_QUIRK(0x106b, 0x5e00, "MacBookPro 11,2", CS4208_MBP11),
 	SND_PCI_QUIRK(0x106b, 0x6c00, "MacMini 7,1", CS4208_MACMINI),
+	SND_PCI_QUIRK(0x106b, 0x6400, "MacBook8,1", CS4208_MACBOOK8_1),
 	SND_PCI_QUIRK(0x106b, 0x7100, "MacBookAir 6,1", CS4208_MBA6),
 	SND_PCI_QUIRK(0x106b, 0x7200, "MacBookAir 6,2", CS4208_MBA6),
 	SND_PCI_QUIRK(0x106b, 0x7b00, "MacBookPro 12,1", CS4208_MBP11),
 	{} /* terminator */
 };

+static void cs4208_fixup_macbook8_1(struct hda_codec *codec,
+				    const struct hda_fixup *fix, int action)
+{
+	if (action == HDA_FIXUP_ACT_INIT) {
+		/*
+		 * MacBook8,1 (12" Early 2015): cs4208_coef_init_verbs enables
+		 * VPW/DSP processing (node 0x24 SET_PROC_STATE=1) but this
+		 * codec's DSP coefficients are not initialized for this model.
+		 * The uninitialised DSP appears to block the internal speaker
+		 * output path entirely. Disable VPW processing so audio bypasses
+		 * the DSP and goes directly to the speaker output pins.
+		 */
+		snd_hda_codec_write(codec, 0x24, 0,
+				    AC_VERB_SET_PROC_STATE, 0x00);
+	}
+}
+
 static const struct hda_fixup cs4208_fixups[] = {
 	[CS4208_MBA6] = {
 		.type = HDA_FIXUP_PINS,
@@ -cs4208_fixups continued
 	[CS4208_MACMINI] = {
 		.type = HDA_FIXUP_FUNC,
 		.v.func = cs4208_fixup_macmini,
 		.chained = true,
 		.chain_id = CS4208_GPIO0,
 	},
+	[CS4208_MACBOOK8_1] = {
+		.type = HDA_FIXUP_FUNC,
+		.v.func = cs4208_fixup_macbook8_1,
+		.chained = true,
+		.chain_id = CS4208_GPIO0,
+	},
 	[CS4208_GPIO0] = {
 		.type = HDA_FIXUP_FUNC,
 		.v.func = cs4208_fixup_gpio0,
 	},
